# Sanity (required)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Public URL of the deployed site (canonical URLs, sitemap, social cards)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Form emails via Resend (https://resend.com). Without these, submissions are only logged on the server.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend. Defaults to onboarding@resend.dev (testing only).
CONTACT_FROM_EMAIL=

# Sanity read token (Viewer role) — enables Studio live preview of unpublished drafts.
# Create: npx sanity tokens add "Website live preview" --role=viewer   (server-side only, never expose)
SANITY_API_READ_TOKEN=

# Sanity webhook secret for instant content updates (see /api/revalidate)
SANITY_REVALIDATE_SECRET=
